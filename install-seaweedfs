download_binaries () {
  echo "  Downloading artifact binaries..." | tee -a "$LOG_FILE"
  cd "$base_dir/utilities/artifacts" || return 1
  read -a ARTIFACTS_TO_DOWNLOAD_ARRAY <<< "$ARTIFACTS_TO_DOWNLOAD"
  for url in "${ARTIFACTS_TO_DOWNLOAD_ARRAY[@]}"; do
    echo "  Downloading $(basename "$url")..." | tee -a "$base_dir/$LOG_FILE"
    if ! curl -kfLO "$url"; then
      echo "  ERROR: failed to download artifact $url" | tee -a "$base_dir/$LOG_FILE"
      cd "$base_dir"
      return 1
    fi
  done
  cd "$base_dir"
}

upload_binaries () {
  echo "  Uploading artifact binaries to SeaweedFS Filer..." | tee -a "$LOG_FILE"
  for file in "$base_dir"/utilities/artifacts/*; do
    if [[ -f "$file" ]]; then
      curl -skfu "$SWFS_USER:$SWFS_PASSWORD" -X POST "https://$MGMT_IP:$SWFS_FILER_PORT/$DEFAULT_FILER_DIR_NAME/$(basename "$file")" -F "file=@$file" \
        || echo "  WARNING: failed to upload artifact $(basename "$file") to the Filer." | tee -a "$LOG_FILE"
    fi
  done
}

