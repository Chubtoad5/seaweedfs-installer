# --- CLI Help --- #

help() {
  cat <<EOF

Usage: $0 [command] [option]

Commands:
  help              | Display this help message
  install           | Install and configure SeaweedFS and Caddy (Docker Compose). CLUSTER_MODE=cluster makes this a cluster-ready control plane.
  join              | Join this host to an existing cluster as a discrete volume node (requires -master). Volume tier only — no Caddy/filer/S3/SMB/NFS/MQ.
  save              | Prepare offline archive for air-gapped deployment
  uninstall         | Uninstall SeaweedFS and Caddy including data and configuration (auto-detects a volume node)

Options:
  push              | Push SeaweedFS and Caddy images to a local registry, must include -registry option
  -registry         | Registry credentials for pushing or pulling from local registry (Format: -registry [registry:port username password])
  -master           | Control-plane master to join (join only). Format: -master <host-or-ip>:$SWFS_MASTER_PORT

Clustering (Phase 2 — start single-node, grow with no data loss):
  CLUSTER_MODE=cluster ./install-seaweedfs install   # node 1: cluster-ready control plane (advertises host IP, publishes cluster ports)
  ./install-seaweedfs join -master <node1-ip>:$SWFS_MASTER_PORT   # node 2/3: add a volume node, then run volume.fix.replication on node 1

Examples:
  $0 install
  $0 save
  $0 uninstall
  $0 install -registry myregistry:5000 user password
  $0 install push -registry myregistry:5000 user password
  CLUSTER_MODE=cluster $0 install
  $0 join -master 192.168.1.10:$SWFS_MASTER_PORT

EOF
}

# --- CLI Wrapper --- #
if [[ "$#" -eq 0 ]]; then
  echo "Error: No arguments provided."
  help
  exit 1
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    help|--help|-h) help; exit 0 ;;
    install)
      INSTALL_MODE=1
      ;;
    save)
      SAVE_MODE=1
      ;;
    push)
      PUSH_MODE=1
      ;;
    uninstall)
      UNINSTALL_MODE=1
      ;;
    join)
      JOIN_MODE=1
      ;;
    -master)
      CLUSTER_MASTER="${2:-}"
      if [[ -z "$CLUSTER_MASTER" ]]; then
        echo "Error: -master requires a control-plane master address. Format: -master <host-or-ip>:$SWFS_MASTER_PORT"
        echo "Use '--help' for usage."
        exit 1
      fi
      shift
      ;;
    -registry)
      REGISTRY_MODE=1
      REGISTRY_INFO="${2:-}"
      REG_USER="${3:-}"
      REG_PASS="${4:-}"
      if [[ -z "$REG_USER" || -z "$REG_PASS" ]]; then
        echo "Error: Registry info requires a username and password. Format: -registry [registry:port username password]"
        echo "Use '--help' for usage."
        exit 1
      fi
      shift 3
      ;;
    *)
      echo "Error: Invalid argument: $1"
      echo "Use 'help' for usage."
      exit 1
      ;;
  esac
  shift
done

check_root_privileges
os_check
# Preflight for minimal images: these must exist before any real work starts.
# Uninstall is exempt - teardown must keep working on air-gapped hosts that
# never had curl/openssl (it only needs docker, systemctl, and coreutils).
if [[ $UNINSTALL_MODE -ne 1 ]]; then
  require_cmds curl tar openssl
fi

# -- Argument Validation -- #
if [[ $INSTALL_MODE -eq 1 ]]; then
  if [[ $UNINSTALL_MODE -eq 1 || $SAVE_MODE -eq 1 || $JOIN_MODE -eq 1 ]]; then
    echo "Error: install, join, save, or uninstall cannot be used together."; exit 1; fi
fi
if [[ $JOIN_MODE -eq 1 ]]; then
  if [[ $INSTALL_MODE -eq 1 || $SAVE_MODE -eq 1 || $UNINSTALL_MODE -eq 1 ]]; then
    echo "Error: install, join, save, or uninstall cannot be used together."; exit 1; fi
  if [[ -z "$CLUSTER_MASTER" ]]; then
    echo "Error: 'join' requires -master <control-plane-host-or-ip>:$SWFS_MASTER_PORT (e.g. -master 192.168.1.10:$SWFS_MASTER_PORT)."
    exit 1; fi
fi
if [[ $UNINSTALL_MODE -eq 1 ]]; then 
  if [[ $INSTALL_MODE -eq 1 || $SAVE_MODE -eq 1 ]]; then 
    echo "Error: install, offline-prep, or uninstall cannot be used together.";exit 1; fi
  if [[ $PUSH_MODE -eq 1 || $REGISTRY_MODE -eq 1 ]]; then
    echo "Error: push or registry cannot be used with uninstall."; exit 1; fi
fi
if [[ $SAVE_MODE -eq 1 ]]; then 
  if [[ $INSTALL_MODE -eq 1 || $UNINSTALL_MODE -eq 1 ]]; then 
    echo "Error: install, offline-prep, or uninstall cannot be used together."; exit 1; fi
  if [[ $PUSH_MODE -eq 1 || $REGISTRY_MODE -eq 1 ]]; then
    echo "Error: push or registry cannot be used with save."; exit 1; fi
fi
if [[ $PUSH_MODE -eq 1 ]]; then
  if [[ $SAVE_MODE -eq 1 || $UNINSTALL_MODE -eq 1 ]]; then
    echo "Error: save or uninstall cannot be used with push."; exit 1; fi
  if [[ $REGISTRY_MODE -eq 0 ]]; then
    echo "Error: 'push' requires the -registry option. Format: push -registry <registry:port> <user> <pass>"; exit 1; fi
fi
if [[ "$REGISTRY_MODE" == "1" ]]; then
  if [[ "$REGISTRY_INFO" =~ ^https?:// ]]; then
    echo "Error: registry info must be a valid FQDN or IPv4 format. i.e. 'my.registry.com:443'."
    exit 1
  fi
  REG_FQDN=$(echo "$REGISTRY_INFO" | cut -d':' -f1)
  REG_PORT=$(echo "$REGISTRY_INFO" | cut -d':' -f2)
  if [[ ! ( "$REG_FQDN" =~ $fqdn_pattern || "$REG_FQDN" =~ $ipv4_pattern ) ]]; then
    echo "Error: Registry url must be a valid FQDN or IPv4 format. i.e. 'my.registry.com' or '192.168.1.50'."
    exit 1
  fi
  if [[ "$REG_PORT" =~ ^[0-9]+$ ]]; then
    if [[ "$REG_PORT" -lt 1 || "$REG_PORT" -gt 65535 ]]; then
      echo "Error: Registry port must be a number between 1 and 65535."
      exit 1
    fi
  else
    echo "Error: Registry port must be a number between 1 and 65535."
    exit 1
  fi
fi
# Air-gap auto-detection with sanity check + explicit override (SW-17). A stale
# sentinel (e.g. a build host that ran 'save' earlier) used to flip later runs into
# air-gapped mode silently.
if [[ -f "$base_dir/swfs-save-version.txt" ]]; then
  if [[ ${SWFS_FORCE_ONLINE,,} == "true" ]]; then
    echo "NOTE: swfs-save-version.txt present but SWFS_FORCE_ONLINE=true — staying in online mode."
  else
    AIR_GAPPED_MODE=1
    if [[ $INSTALL_MODE -eq 1 || $JOIN_MODE -eq 1 ]]; then
      shopt -s nullglob
      _swfs_archives=("$base_dir"/utilities/container_images_*.tar.gz)
      shopt -u nullglob
      if [[ ${#_swfs_archives[@]} -eq 0 ]]; then
        echo "ERROR: swfs-save-version.txt found (air-gapped mode) but no container_images_*.tar.gz in $base_dir/utilities/."
        echo "Either extract the full swfs-save.tar.gz here, delete the stale sentinel, or set SWFS_FORCE_ONLINE=true."
        exit 1
      fi
    fi
    if [[ $SAVE_MODE -eq 1 ]]; then
      echo "WARNING: 'save' is running in a directory containing swfs-save-version.txt — this run is treated as"
      echo "         air-gapped (AGPL source fetch is skipped). Set SWFS_FORCE_ONLINE=true to build a fresh bundle online."
    fi
  fi
fi




# -- Main Logic -- #

# The install log receives credentials — restrict it before anything writes to it (SW-13).
if [[ $UNINSTALL_MODE -eq 0 ]]; then
  touch "$LOG_FILE" && chmod 600 "$LOG_FILE"
fi

echo "### SeaweedFS Installer Started - $(date) ###"
display_args

[[ -d $base_dir/utilities/artifacts ]] || mkdir -p $base_dir/utilities/artifacts
if [[ $INSTALL_MODE -eq 1 ]]; then
  echo "### SeaweedFS/Caddy Installation Starting ###"
  install_swfs
fi
if [[ $JOIN_MODE -eq 1 ]]; then
  echo "### SeaweedFS Volume Node Join Starting ###"
  run_join
fi
if [[ $SAVE_MODE -eq 1 ]]; then
  echo "### SeaweedFS/Caddy Save Starting ###"
  run_save
fi
if [[ $UNINSTALL_MODE -eq 1 ]]; then 
  echo "### SeaweedFS/Caddy Uninstallation Starting ###"
  uninstall_swfs
fi
echo "### SeaweedFS Installer Finished - $(date) ###"