setup_monitoring () {
  mkdir -p /opt/monitoring/{loki/data,prometheus/data,grafana/data,grafana/provisioning/datasources}
  # Data dirs owned by each container's runtime user instead of world-writable (SW-23):
  # loki=10001, prometheus=nobody(65534), grafana=472.
  chown 10001:10001 /opt/monitoring/loki/data
  chown 65534:65534 /opt/monitoring/prometheus/data
  chown 472:472 /opt/monitoring/grafana/data
  chmod 750 /opt/monitoring/loki/data /opt/monitoring/prometheus/data /opt/monitoring/grafana/data
  local loki_before prom_before ds_before
  loki_before=$(file_md5 /opt/monitoring/loki/loki-config.yaml)
  prom_before=$(file_md5 /opt/monitoring/prometheus/prometheus.yml)
  ds_before=$(file_md5 /opt/monitoring/grafana/provisioning/datasources/datasources.yaml)
  generate_loki_config
  generate_prometheus_ext_config
  generate_grafana_datasources
  generate_monitoring_compose
  write_monitoring_credentials
  echo "  Starting monitoring stack (Loki, Grafana, Prometheus)..."
  docker compose -f /opt/monitoring/docker-compose.yml up -d --remove-orphans \
    || die "docker compose up failed for /opt/monitoring/docker-compose.yml."
  record_state MONITORING_CONFIGURED "true"
  # Apply regenerated bind-mounted configs to running containers (SW-8).
  restart_if_changed loki "$loki_before" "$(file_md5 /opt/monitoring/loki/loki-config.yaml)"
  restart_if_changed prometheus "$prom_before" "$(file_md5 /opt/monitoring/prometheus/prometheus.yml)"
  restart_if_changed grafana "$ds_before" "$(file_md5 /opt/monitoring/grafana/provisioning/datasources/datasources.yaml)"
  echo "  Waiting for monitoring stack to become healthy..."
  local attempt=1
  while [[ $attempt -le 12 ]]; do
    local loki_ready=$(docker exec loki wget --quiet --tries=1 --output-document=- http://localhost:3100/ready 2>/dev/null || true)
    if [[ "$loki_ready" == "ready" ]]; then
      echo "  Monitoring stack is healthy."
      break
    fi
    echo "  Waiting for Loki... attempt $attempt/12"
    ((attempt++))
    sleep 10
  done
  if [[ $attempt -gt 12 ]]; then
    echo "  WARNING: Loki did not report ready within 120s — monitoring may still be starting. Check 'docker logs loki'." | tee -a "$LOG_FILE"
  fi
}

debug_run() {
  if [ "$DEBUG" -eq 1 ]; then
    echo "--- DEBUG: Running '$*' ---"
    "$@"
    local status=$?
    echo "--- DEBUG: Finished '$*' with status $status ---"
    return $status
  else
    "$@" >/dev/null 2>&1
    return $?
  fi
}

check_root_privileges() {
  if [[ $EUID != 0 ]]; then
    echo "This script must be run with sudo or as the root user."
    exit 1
  fi
}

os_check () {
  # Get OS information from /etc/os-release
  if [[ -f /etc/os-release ]]; then
    # shellcheck disable=SC1091
    source /etc/os-release
    OS_ID_LIKE="${ID_LIKE:-}"
    OS_ID="${ID:-}"
  else
    echo "Unknown or unsupported OS $OS_ID."
    exit 1
  fi
  if [[ ! "$OS_ID" =~ ^(ubuntu|debian|rhel|centos|rocky|almalinux|fedora|sles|opensuse-leap)$ ]]; then
    echo "Unknown or unsupported OS $OS_ID."
    exit 1
  fi
  # NFS server package name is distro-specific (SW-1): 'nfs-kernel-server' does not
  # exist on the RHEL family — requesting it there silently left NFS uninstalled and
  # produced save bundles without NFS packages.
  case "$OS_ID" in
    rhel|centos|rocky|almalinux|fedora) NFS_PACKAGE="nfs-utils" ;;
    *)                                  NFS_PACKAGE="nfs-kernel-server" ;;  # Debian/Ubuntu and SUSE both ship nfs-kernel-server
  esac
}

# best-effort source fetch; never fails the save ($1=url $2=dest $3=label)
fetch_copyleft_source() {
  if curl -fsSL --retry 2 -o "$2" "$1" 2>/dev/null; then
    echo "    bundled $3 source: $(basename "$2") ($(du -h "$2" | cut -f1))"
  else
    echo "    NOTE: could not fetch $3 source ($1) — the written offer covers it."
    rm -f "$2"
  fi
}

# Write a LICENSES/ dir into the air-gap archive: a third-party manifest for all
# bundled images, plus (when the AGPL monitoring stack is bundled) an AGPLv3 written
# offer for Grafana + Loki and, with BUNDLE_COPYLEFT_SOURCE=true, their pinned source
# tarballs. Satisfies the GPL/AGPL "corresponding source or written offer" requirement.
generate_bundle_licenses() {
  local dir="$base_dir/LICENSES"
  rm -rf "$dir"; mkdir -p "$dir"
  local mon="no"; [[ ${ENABLE_MONITORING,,} == "true" ]] && mon="yes"
  {
    echo "Third-party components redistributed in this SeaweedFS air-gap bundle"
    echo "Generated: $(date)"
    echo ""
    printf "%-34s %-11s %s\n" "Container image" "License" "Upstream source"
    printf "%-34s %-11s %s\n" "---------------------------------" "-----------" "--------------------------------------"
    printf "%-34s %-11s %s\n" "$SWFS_IMAGE"  "Apache-2.0" "https://github.com/seaweedfs/seaweedfs"
    printf "%-34s %-11s %s\n" "$CADDY_IMAGE" "Apache-2.0" "https://github.com/caddyserver/caddy"
    if [[ "$mon" == "yes" ]]; then
      printf "%-34s %-11s %s\n" "$PROMETHEUS_EXT_IMAGE" "Apache-2.0" "https://github.com/prometheus/prometheus"
      printf "%-34s %-11s %s\n" "$GRAFANA_IMAGE" "AGPL-3.0" "https://github.com/grafana/grafana (see WRITTEN_OFFER.txt)"
      printf "%-34s %-11s %s\n" "$LOKI_IMAGE"    "AGPL-3.0" "https://github.com/grafana/loki (see WRITTEN_OFFER.txt)"
    fi
    echo ""
    echo "OS distribution packages bundled via install-packages (each keeps its own license):"
    echo "  samba ............... GPL-3.0-or-later   (see WRITTEN_OFFER.txt)"
    printf "  %-21s GPL-2.0-or-later   (see WRITTEN_OFFER.txt)\\n" "$NFS_PACKAGE ...."
    echo "The installer scripts themselves are Apache-2.0 (Chubtoad5)."
  } > "$dir/THIRD_PARTY_NOTICES.txt"

  # The bundle ALWAYS redistributes GPL OS packages (samba GPL-3.0, nfs GPL-2.0) and,
  # when monitoring is on, AGPL Grafana + Loki images. Always write a covering offer.
  local gver="${GRAFANA_IMAGE##*:}" lver="${LOKI_IMAGE##*:}"
  {
    echo "WRITTEN OFFER FOR CORRESPONDING SOURCE CODE"
    echo ""
    echo "This air-gap bundle redistributes the following copyleft-licensed components:"
    echo ""
    echo "OS distribution packages (bundled via install-packages):"
    echo "  samba ............... GPL-3.0-or-later"
    printf "  %-21s GPL-2.0-or-later\\n" "$NFS_PACKAGE ...."
    echo "Their corresponding source is available from the OS distribution's own source"
    echo "archives ('apt-get source <pkg>' / the distro source mirrors for the bundled version)."
    if [[ "$mon" == "yes" ]]; then
      echo ""
      echo "Container images (AGPL-3.0), redistributed UNMODIFIED (so AGPLv3 s.13 does not apply):"
      echo "  Grafana ($GRAFANA_IMAGE)  ->  https://github.com/grafana/grafana  (tag v${gver})"
      echo "  Loki    ($LOKI_IMAGE)      ->  https://github.com/grafana/loki      (tag v${lver})"
    fi
    echo ""
    echo "In accordance with GPLv2 section 3 / GPLv3 + AGPLv3 section 6, the distributor of"
    echo "this bundle hereby makes a written offer, valid for three (3) years from the date"
    echo "this bundle was created ($(date +%Y-%m-%d)), to give any third party who possesses"
    echo "this bundle a complete machine-readable copy of the corresponding source code for"
    echo "the components above, for no more than the cost of physically performing the"
    echo "source distribution."
    echo ""
    echo "To request the source on a physical medium, contact: ${LICENSE_OFFER_CONTACT}"
    echo ""
    echo "This offer is independent of the Apache-2.0 license covering the installer scripts."
  } > "$dir/WRITTEN_OFFER.txt"

  if [[ "$mon" == "yes" && ${BUNDLE_COPYLEFT_SOURCE,,} == "true" && $AIR_GAPPED_MODE -eq 0 ]]; then
    mkdir -p "$dir/source"
    echo "  Fetching AGPL corresponding source (Grafana/Loki) — set BUNDLE_COPYLEFT_SOURCE=false to skip..."
    fetch_copyleft_source "https://github.com/grafana/grafana/archive/refs/tags/v${gver}.tar.gz" "$dir/source/grafana-v${gver}-source.tar.gz" "Grafana"
    fetch_copyleft_source "https://github.com/grafana/loki/archive/refs/tags/v${lver}.tar.gz" "$dir/source/loki-v${lver}-source.tar.gz" "Loki"
  fi
  if [[ "$mon" == "yes" ]]; then
    echo "  Wrote LICENSES/ (manifest + written offer: GPL OS packages + AGPL Grafana/Loki)."
  else
    echo "  Wrote LICENSES/ (manifest + written offer: GPL OS packages samba/nfs)."
  fi
}

run_save () {
  echo "  Preparing SeaweedFS offline archive..."
  debug_run download_image_pull_push
  debug_run download_install_packages
  cat >"$base_dir/utilities/images.txt" <<EOF
$SWFS_IMAGE
$CADDY_IMAGE
EOF
  if [[ ${ENABLE_MONITORING,,} == "true" ]]; then
    cat >> "$base_dir/utilities/images.txt" <<EOF
$LOKI_IMAGE
$GRAFANA_IMAGE
$PROMETHEUS_EXT_IMAGE
EOF
  fi
  cd "$base_dir/utilities" || die "Cannot enter $base_dir/utilities."
  debug_run ./image_pull_push.sh -f "$base_dir/utilities/images.txt" save \
    || die "image_pull_push.sh save failed — container image archive was not produced."
  # Save Samba + NFS packages into ONE offline-packages.tar.gz. install_packages.sh 'save'
  # recreates the bundle on each call, so two separate calls left only the last package set
  # in the archive (samba was lost) and broke the air-gapped SMB install. One combined call
  # downloads both dependency trees into a single archive.
  # NFS server package name is distro-specific ($NFS_PACKAGE, set by os_check).
  ./install_packages.sh save samba "$NFS_PACKAGE" \
    || die "install_packages.sh save (samba $NFS_PACKAGE) failed — OS package bundle was not produced."
  cd "$base_dir"
  debug_run download_binaries || die "Artifact download failed."
  cat > "$base_dir/swfs-save-version.txt" <<EOF
# SeaweedFS Installer Save Archive
# Created: $(date)
#
# Container images included:
$SWFS_IMAGE
$CADDY_IMAGE
$(if [[ ${ENABLE_MONITORING,,} == "true" ]]; then printf "%s\n%s\n%s" "$LOKI_IMAGE" "$GRAFANA_IMAGE" "$PROMETHEUS_EXT_IMAGE"; fi)
EOF
  generate_bundle_licenses
  tar czf "$base_dir/swfs-save.tar.gz" utilities install-seaweedfs swfs-save-version.txt LICENSES \
    || die "Failed to create swfs-save.tar.gz."
  echo "  created 'swfs-save.tar.gz' for air-gapped deployment."
}

run_join () {
  echo "# -- SeaweedFS Volume Join Started - $(date) -- #" | tee -a "$LOG_FILE"
  echo "  Joining control-plane master at $CLUSTER_MASTER as a volume node (ip=$MGMT_IP, dc=$CLUSTER_DC, rack=$CLUSTER_RACK)..."
  mkdir -p /opt/seaweedfs/volume
  debug_run run_docker || die "Docker/image preparation failed."
  generate_join_compose_file
  echo "  Starting SeaweedFS volume node..."
  docker compose -f /opt/seaweedfs/seaweedfs-volume-compose.yaml up -d --remove-orphans \
    || die "docker compose up failed for /opt/seaweedfs/seaweedfs-volume-compose.yaml."
  configure_firewall "$CLUSTER_VOLUME_PORT/tcp $CLUSTER_VOLUME_GRPC_PORT/tcp" "false" "false"
  generate_join_outputs
}

generate_join_compose_file () {
  local swfs_image_local="$SWFS_IMAGE"
  if [[ $PUSH_MODE -eq 1 || $REGISTRY_MODE -eq 1 ]]; then
    swfs_image_local="${REG_FQDN}:${REG_PORT}/$SWFS_IMAGE"
  fi
  local VOL_TUNING=""
  [[ -n "$VOLUME_INDEX" ]] && VOL_TUNING+="      -index=$VOLUME_INDEX"$'\n'
  record_state STATE_VERSION "1"
  record_state NODE_ROLE "volume"
  record_state LOADED_IMAGES "$swfs_image_local"
  echo "  Creating seaweedfs-volume-compose.yaml..." | tee -a "$LOG_FILE"
  cat > /opt/seaweedfs/seaweedfs-volume-compose.yaml <<EOF
networks:
  seaweed_net:
    name: seaweed_net
services:
  seaweed-volume:
    image: $swfs_image_local
    container_name: seaweed-volume
    command: >
      volume
      -master=$CLUSTER_MASTER
      -ip=$MGMT_IP
      -ip.bind=0.0.0.0
      -dir=/data
      -max=0
      -dataCenter=$CLUSTER_DC
      -rack=$CLUSTER_RACK
      -port=$CLUSTER_VOLUME_PORT
      -port.grpc=$CLUSTER_VOLUME_GRPC_PORT
${VOL_TUNING}    volumes:
      - /opt/seaweedfs/volume:/data
    ports:
      - "$CLUSTER_VOLUME_PORT:$CLUSTER_VOLUME_PORT"
      - "$CLUSTER_VOLUME_GRPC_PORT:$CLUSTER_VOLUME_GRPC_PORT"
    networks:
      - seaweed_net
    restart: unless-stopped
EOF
}

generate_join_outputs () {
  cat <<EOF | tee -a "$LOG_FILE"

# -- SeaweedFS Volume Node Joined - $(date) -- #

  This host is now a SeaweedFS volume node in the cluster.
  Joined master:        $CLUSTER_MASTER
  Advertised volume:    $MGMT_IP:$CLUSTER_VOLUME_PORT (grpc $CLUSTER_VOLUME_GRPC_PORT)
  Topology:             dataCenter=$CLUSTER_DC rack=$CLUSTER_RACK
  Data directory:       /opt/seaweedfs/volume
  Compose file:         /opt/seaweedfs/seaweedfs-volume-compose.yaml

  NEXT STEPS on the control-plane node (node 1) to make the cluster redundant with NO data loss:

  1. Raise default replication for NEW writes (re-run install on node 1; brief data-plane restart, data kept):
       sudo CLUSTER_MODE=cluster CLUSTER_REPLICATION=001 ./install-seaweedfs install

  2. Replicate EXISTING data onto this node. fix.replication only acts on under-replicated volumes, so first
     raise existing volumes' replication, then fix (a single weed-shell session; 'lock' is required):
       printf 'lock\nvolume.configure.replication -replication 001\nvolume.fix.replication -apply\nunlock\n' \
         | sudo docker exec -i seaweed-mini weed shell -master=localhost:$SWFS_MASTER_PORT

  Verify (each volume should now report 2 copies, one on each node):
       printf 'lock\nvolume.list\nunlock\n' | sudo docker exec -i seaweed-mini weed shell -master=localhost:$SWFS_MASTER_PORT
EOF
}

uninstall_swfs () {
  LOG_FILE="seaweedfs-uninstall.log"
  touch "$LOG_FILE" && chmod 600 "$LOG_FILE"
  # Read the recorded install state BEFORE anything is removed (SW-2). Cleanup
  # decisions key on what was actually configured at install time — never on the
  # ENABLE_* env present at uninstall time.
  local st_smb="" st_nfs="" st_user_created="false" st_user_name="$SWFS_USER"
  local st_smb_service="" st_nfs_service="" st_share_name="$DEFAULT_FILER_DIR_NAME"
  local st_fuse_action="" st_registry_login="" st_images="" st_mon_images=""
  local st_fwd_ports="" st_fwd_services="" st_ufw_ports="" st_selinux_prior=""
  local have_state=0
  if [[ -f "$STATE_FILE" ]]; then
    have_state=1
    st_smb=$(get_state SMB_CONFIGURED)
    st_nfs=$(get_state NFS_CONFIGURED)
    st_user_created=$(get_state SWFS_USER_CREATED)
    st_user_name=$(get_state SWFS_USER_NAME); st_user_name=${st_user_name:-$SWFS_USER}
    st_smb_service=$(get_state SMB_SERVICE_NAME)
    st_nfs_service=$(get_state NFS_SERVICE_NAME)
    st_share_name=$(get_state FILER_DIR_NAME); st_share_name=${st_share_name:-$DEFAULT_FILER_DIR_NAME}
    st_fuse_action=$(get_state FUSE_CONF_ACTION)
    st_registry_login=$(get_state REGISTRY_LOGIN)
    st_images=$(get_state LOADED_IMAGES)
    st_mon_images=$(get_state LOADED_MONITORING_IMAGES)
    st_fwd_ports=$(get_state FIREWALLD_ADDED_PORTS)
    st_fwd_services=$(get_state FIREWALLD_ADDED_SERVICES)
    st_ufw_ports=$(get_state UFW_ADDED_PORTS)
    st_selinux_prior=$(get_state SELINUX_SAMBA_FUSEFS_PRIOR)
  else
    echo "  NOTE: no install-state file found ($STATE_FILE) — pre-state-file install or already uninstalled." | tee -a "$LOG_FILE"
    echo "  Falling back to ENABLE_* env plus on-disk evidence for SMB/NFS cleanup; user accounts will NOT be removed." | tee -a "$LOG_FILE"
    st_smb="${ENABLE_SMB,,}"
    st_nfs="${ENABLE_NFS,,}"
  fi
  # --- Volume (join) node --- #
  if [[ -f /opt/seaweedfs/seaweedfs-volume-compose.yaml ]]; then
    echo "  Detected a SeaweedFS volume (join) node." | tee -a "$LOG_FILE"
    echo "  WARNING: replicate/evacuate this node's volumes to surviving nodes first (set replication, run" | tee -a "$LOG_FILE"
    echo "  'volume.fix.replication -apply' on node 1, confirm full replica counts) or data held only here is lost." | tee -a "$LOG_FILE"
    echo "  Stopping and removing the SeaweedFS volume container..." | tee -a "$LOG_FILE"
    docker compose -f /opt/seaweedfs/seaweedfs-volume-compose.yaml down --remove-orphans
    remove_firewall_rules "$st_fwd_ports" "$st_fwd_services" "$st_ufw_ports"
    uninstall_docker_residue "$st_registry_login" "$st_images" "$st_mon_images"
    rm -rf /opt/seaweedfs
    echo "# -- Volume node uninstall complete -- #" | tee -a "$LOG_FILE"
    return
  fi
  # --- Containers and data --- #
  if [[ -f /opt/monitoring/docker-compose.yml ]]; then
    echo "  Stopping monitoring stack (Loki, Grafana, Prometheus)..." | tee -a "$LOG_FILE"
    docker compose -f /opt/monitoring/docker-compose.yml down --remove-orphans
  fi
  rm -rf /opt/monitoring
  echo "  Stopping and removing SeaweedFS and Caddy containers..." | tee -a "$LOG_FILE"
  if [[ -f /opt/seaweedfs/seaweedfs-compose.yaml ]]; then
    docker compose -f /opt/seaweedfs/seaweedfs-compose.yaml down --remove-orphans
  fi
  echo "  Removing SeaweedFS and Caddy data and configuration..." | tee -a "$LOG_FILE"
  rm -rf /opt/seaweedfs
  rm -rf /opt/caddy
  # FUSE mountpoint (SW-24): compose down should have unmounted it; lazy-unmount any
  # leftover, and only remove the directory once it is no longer a mountpoint.
  if mountpoint -q /mnt/seaweed 2>/dev/null; then
    umount -l /mnt/seaweed 2>/dev/null
  fi
  if [[ -d /mnt/seaweed ]] && ! mountpoint -q /mnt/seaweed 2>/dev/null; then
    rm -rf /mnt/seaweed
  fi
  # --- Samba (only if THIS tool configured it) --- #
  if [[ "$st_smb" == "true" ]]; then
    local smb_service="$st_smb_service"
    if [[ -z "$smb_service" ]]; then
      smb_service="$SMB_SERVICE"
      [[ $ID != "ubuntu" && $ID != "debian" ]] && smb_service="smb"
    fi
    local do_smb=1
    if [[ $have_state -eq 0 ]]; then
      # Legacy fallback: only touch Samba when there is on-disk evidence of our share.
      if ! grep -q "^${MARKER_BEGIN}\$" /etc/samba/smb.conf 2>/dev/null \
         && ! grep -q "^\[${st_share_name}\]" /etc/samba/smb.conf 2>/dev/null; then
        echo "  No seaweedfs share found in /etc/samba/smb.conf — skipping SMB cleanup." | tee -a "$LOG_FILE"
        do_smb=0
      fi
    fi
    if [[ $do_smb -eq 1 ]]; then
      echo "  Removing seaweedfs share from the Samba configuration..." | tee -a "$LOG_FILE"
      # Marker-based removal — never delete or wholesale-replace the host's smb.conf
      # (SW-3: the old .bak-consumption semantics destroyed smb.conf on double-uninstall).
      remove_marker_block /etc/samba/smb.conf
      remove_legacy_smb_block "$st_share_name"
      rm -f /etc/samba/smb.conf.bak
      echo "  Removing Samba account for '$st_user_name'..." | tee -a "$LOG_FILE"
      smbpasswd -x "$st_user_name" 2>/dev/null || true
      if [[ "$st_user_created" == "true" ]] && id "$st_user_name" &>/dev/null; then
        echo "  Removing system user '$st_user_name' (created by this installer)..." | tee -a "$LOG_FILE"
        userdel "$st_user_name"
      else
        echo "  Keeping system user '$st_user_name' (not created by this installer)." | tee -a "$LOG_FILE"
      fi
      systemctl restart "$smb_service" 2>/dev/null \
        || echo "  WARNING: could not restart Samba service '$smb_service'." | tee -a "$LOG_FILE"
    fi
  fi
  # --- NFS (only if THIS tool configured it) --- #
  if [[ "$st_nfs" == "true" ]]; then
    local nfs_service="$st_nfs_service"
    if [[ -z "$nfs_service" ]]; then
      nfs_service="$NFS_SERVICE"
      [[ $ID == "ubuntu" || $ID == "debian" ]] && nfs_service="nfs-kernel-server"
    fi
    if [[ $have_state -eq 1 ]] || grep -q ' # seaweedfs-installer$' /etc/exports 2>/dev/null; then
      echo "  Removing SeaweedFS NFS export..." | tee -a "$LOG_FILE"
      [[ -f /etc/exports ]] && sed -i '/ # seaweedfs-installer$/d' /etc/exports
      exportfs -ra 2>/dev/null
      systemctl restart "$nfs_service" 2>/dev/null \
        || echo "  WARNING: could not restart NFS service '$nfs_service'." | tee -a "$LOG_FILE"
      echo "  Removing NFS metadata refresh timer..." | tee -a "$LOG_FILE"
      systemctl disable --now seaweedfs-nfs-meta-refresh.timer >/dev/null 2>&1
      rm -f /etc/systemd/system/seaweedfs-nfs-meta-refresh.service /etc/systemd/system/seaweedfs-nfs-meta-refresh.timer
      systemctl daemon-reload
    else
      echo "  No seaweedfs export found in /etc/exports — skipping NFS cleanup." | tee -a "$LOG_FILE"
    fi
  fi
  # --- /etc/fuse.conf restore (SW-12) --- #
  case "$st_fuse_action" in
    created)
      remove_marker_block /etc/fuse.conf
      [[ -s /etc/fuse.conf ]] || rm -f /etc/fuse.conf
      ;;
    backed_up)
      if [[ -f /etc/fuse.conf.seaweedfs-bak ]]; then
        echo "  Restoring /etc/fuse.conf from backup..." | tee -a "$LOG_FILE"
        mv /etc/fuse.conf.seaweedfs-bak /etc/fuse.conf
      else
        remove_marker_block /etc/fuse.conf
      fi
      ;;
    untouched)
      : # we never modified it
      ;;
    *)
      # No/unknown state: strip our marker block if present; never delete the file.
      remove_marker_block /etc/fuse.conf
      ;;
  esac
  remove_firewall_rules "$st_fwd_ports" "$st_fwd_services" "$st_ufw_ports"
  # Restore the SELinux boolean only if THIS tool changed it (recorded prior value).
  if [[ -n "$st_selinux_prior" && "$st_selinux_prior" != "on" ]] && command -v setsebool >/dev/null 2>&1; then
    echo "  Restoring SELinux boolean samba_share_fusefs=$st_selinux_prior..." | tee -a "$LOG_FILE"
    setsebool -P samba_share_fusefs "$st_selinux_prior" 2>/dev/null
  fi
  uninstall_docker_residue "$st_registry_login" "$st_images" "$st_mon_images"
  # The install log contains credentials (SW-24) — remove it with the deployment.
  if [[ -f "$base_dir/seaweedfs-install.log" ]]; then
    echo "  Removing $base_dir/seaweedfs-install.log (contains credentials)..." | tee -a "$LOG_FILE"
    rm -f "$base_dir/seaweedfs-install.log"
  fi
  echo "# -- Uninstall tasks complete -- #" | tee -a "$LOG_FILE"
}

# Registry logout + optional removal of the images this installer loaded (SW-24).
# $1=recorded registry login, $2/$3=recorded image lists.
uninstall_docker_residue () {
  local registry_login="$1" images="$2 $3" img
  if [[ -n "$registry_login" ]]; then
    echo "  Logging out of registry $registry_login..." | tee -a "$LOG_FILE"
    docker logout "$registry_login" >/dev/null 2>&1
  fi
  if [[ ${SWFS_REMOVE_IMAGES,,} == "true" ]]; then
    echo "  Removing container images loaded by this installer (SWFS_REMOVE_IMAGES=true)..." | tee -a "$LOG_FILE"
    for img in $images; do
      docker rmi "$img" >/dev/null 2>&1 || true
    done
  fi
}

