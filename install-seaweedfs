# -- Functions -- #

# Print an error, record it in the log, and exit non-zero. Callers (ap-tools) rely on
# a truthful exit code: exit 0 means the requested operation actually succeeded.
die() {
  echo "ERROR: $*" >&2
  echo "ERROR: $*" 2>/dev/null >> "$LOG_FILE"
  exit 1
}

# Exact-match membership test: list_contains <needle> "<space separated list>"
# (regex =~ matching false-positives on metacharacters in bucket names; this does not)
list_contains() {
  local needle="$1" item
  for item in $2; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

# Dependency preflight for minimal images: fail early with a distro-appropriate hint
# instead of an opaque failure mid-install.
require_cmds() {
  local missing=() c
  for c in "$@"; do
    command -v "$c" >/dev/null 2>&1 || missing+=("$c")
  done
  [[ ${#missing[@]} -eq 0 ]] && return 0
  local hint="apt-get install -y"
  case "$OS_ID" in
    rhel|centos|rocky|almalinux|fedora) hint="dnf install -y" ;;
    sles|opensuse-leap) hint="zypper install -y" ;;
  esac
  die "Missing required command(s): ${missing[*]}. Install them first, e.g.: sudo $hint ${missing[*]}"
}

# --- Install-state recording (SW-2) --- #
# The state file records what THIS tool actually changed on the host, so uninstall
# reverts exactly that — never keyed on the ENABLE_* env present at uninstall time.
# Format: KEY=value lines, one per key (last write wins), mode 600.
record_state() {
  local key="$1" value="$2"
  mkdir -p "$(dirname "$STATE_FILE")"
  [[ -f "$STATE_FILE" ]] || touch "$STATE_FILE"
  chmod 600 "$STATE_FILE"
  sed -i "/^${key}=/d" "$STATE_FILE"
  echo "${key}=${value}" >> "$STATE_FILE"
}

# get_state <key> — prints the recorded value (empty if unset / no state file)
get_state() {
  [[ -f "$STATE_FILE" ]] || return 1
  sed -n "s/^$1=//p" "$STATE_FILE" | tail -1
}

# Remove the marker-delimited seaweedfs-installer block from a file (no-op when absent).
remove_marker_block() {
  local target="$1"
  [[ -f "$target" ]] || return 0
  sed -i "\|^${MARKER_BEGIN}\$|,\|^${MARKER_END}\$|d" "$target"
}

# Remove a legacy (pre-marker) seaweedfs share block from smb.conf: older releases
# appended the share section without markers, so reconciliation must strip it too or a
# re-install would leave a duplicate share definition behind.
remove_legacy_smb_block() {
  local conf="/etc/samba/smb.conf" share="$1"
  [[ -f "$conf" ]] || return 0
  grep -qF "[${share}]" "$conf" || return 0
  # Bounded removal: drop only the span from the share header to its
  # 'force group = root' terminator. If another section header appears first
  # (user-authored section with the same name, or a truncated block), leave the
  # file untouched - an unterminated sed range would eat everything to EOF.
  local tmp
  tmp=$(mktemp)
  if awk -v hdr="[${share}]" '
      BEGIN { inblk=0 }
      {
        if (!inblk && $0 == hdr) { inblk=1; next }
        if (inblk) {
          if ($0 == "   force group = root") { inblk=0; next }
          if (substr($0,1,1) == "[") { exit 1 }
          next
        }
        print
      }
      END { if (inblk) exit 1 }
    ' "$conf" > "$tmp"; then
    cat "$tmp" > "$conf"
  else
    echo "  WARNING: found a [${share}] section in smb.conf that does not match the legacy installer format; leaving smb.conf untouched. Remove the stale section manually if it is a leftover."
  fi
  rm -f "$tmp"
}

# Never clobber the host's /etc/fuse.conf (SW-12): back it up (or create it) and
# append user_allow_other inside a marker block; record the action for uninstall.
configure_fuse_conf() {
  if [[ -f /etc/fuse.conf ]]; then
    remove_marker_block /etc/fuse.conf
    if grep -qE '^[[:space:]]*user_allow_other[[:space:]]*$' /etc/fuse.conf; then
      # The host already enables user_allow_other on its own — change nothing.
      record_state FUSE_CONF_ACTION "untouched"
      return 0
    fi
    if [[ "$(get_state FUSE_CONF_ACTION)" != "created" ]]; then
      [[ -f /etc/fuse.conf.seaweedfs-bak ]] || cp -p /etc/fuse.conf /etc/fuse.conf.seaweedfs-bak
      record_state FUSE_CONF_ACTION "backed_up"
    fi
  else
    touch /etc/fuse.conf
    record_state FUSE_CONF_ACTION "created"
  fi
  cat >> /etc/fuse.conf <<EOF
${MARKER_BEGIN}
user_allow_other
${MARKER_END}
EOF
}

file_md5() { md5sum "$1" 2>/dev/null | cut -d' ' -f1; }

# Restart a running container when its bind-mounted config content changed (SW-8):
# 'docker compose up' only reacts to compose-file changes, not to regenerated
# bind-mounted configs, so password/setting rotations never reached the containers.
restart_if_changed() {
  local container="$1" before="$2" after="$3"
  [[ "$before" == "$after" ]] && return 0
  if docker ps --format '{{.Names}}' 2>/dev/null | grep -Fxq "$container"; then
    echo "  Configuration changed — restarting $container..."
    docker restart "$container" >/dev/null 2>&1
  fi
}

# Re-install convergence (SW-7): when a previous install configured something that is
# now toggled off via ENABLE_*, tear that piece down so re-install converges instead
# of leaving orphan stacks/config behind. Driven by the recorded install state.
reconcile_disabled_services() {
  [[ -f "$STATE_FILE" ]] || return 0
  # Monitoring stack
  if [[ ${ENABLE_MONITORING,,} != "true" && "$(get_state MONITORING_CONFIGURED)" == "true" ]]; then
    echo "  ENABLE_MONITORING=false — removing previously-installed monitoring stack..."
    [[ -f /opt/monitoring/docker-compose.yml ]] && docker compose -f /opt/monitoring/docker-compose.yml down --remove-orphans
    rm -rf /opt/monitoring
    rm -f /opt/seaweedfs/monitoring-credentials.env
    record_state MONITORING_CONFIGURED "false"
    record_state LOADED_MONITORING_IMAGES ""
  fi
  # Samba share
  if [[ ${ENABLE_SMB,,} != "true" && "$(get_state SMB_CONFIGURED)" == "true" ]]; then
    echo "  ENABLE_SMB=false — removing previously-configured Samba share..."
    local smb_service share user created
    smb_service=$(get_state SMB_SERVICE_NAME); smb_service=${smb_service:-$SMB_SERVICE}
    share=$(get_state SMB_SHARE_NAME); share=${share:-$DEFAULT_FILER_DIR_NAME}
    user=$(get_state SWFS_USER_NAME); user=${user:-$SWFS_USER}
    created=$(get_state SWFS_USER_CREATED)
    remove_marker_block /etc/samba/smb.conf
    remove_legacy_smb_block "$share"
    smbpasswd -x "$user" 2>/dev/null || true
    if [[ "$created" == "true" ]] && id "$user" &>/dev/null; then
      userdel "$user"
    fi
    systemctl restart "$smb_service" 2>/dev/null
    record_state SMB_CONFIGURED "false"
    record_state SWFS_USER_CREATED "false"
  fi
  # NFS export + refresh timer
  if [[ ${ENABLE_NFS,,} != "true" && "$(get_state NFS_CONFIGURED)" == "true" ]]; then
    echo "  ENABLE_NFS=false — removing previously-configured NFS export..."
    local nfs_service
    nfs_service=$(get_state NFS_SERVICE_NAME)
    if [[ -z "$nfs_service" ]]; then
      nfs_service="$NFS_SERVICE"
      [[ $ID == "ubuntu" || $ID == "debian" ]] && nfs_service="nfs-kernel-server"
    fi
    [[ -f /etc/exports ]] && sed -i '/ # seaweedfs-installer$/d' /etc/exports
    exportfs -ra 2>/dev/null
    systemctl restart "$nfs_service" 2>/dev/null
    systemctl disable --now seaweedfs-nfs-meta-refresh.timer >/dev/null 2>&1
    rm -f /etc/systemd/system/seaweedfs-nfs-meta-refresh.service /etc/systemd/system/seaweedfs-nfs-meta-refresh.timer
    systemctl daemon-reload
    record_state NFS_CONFIGURED "false"
  fi
  # fuse.conf: when neither share type is wanted anymore, revert the recorded change.
  if [[ ${ENABLE_SMB,,} != "true" && ${ENABLE_NFS,,} != "true" ]]; then
    case "$(get_state FUSE_CONF_ACTION)" in
      created)
        remove_marker_block /etc/fuse.conf
        [[ -s /etc/fuse.conf ]] || rm -f /etc/fuse.conf
        record_state FUSE_CONF_ACTION ""
        ;;
      backed_up)
        if [[ -f /etc/fuse.conf.seaweedfs-bak ]]; then
          mv /etc/fuse.conf.seaweedfs-bak /etc/fuse.conf
        else
          remove_marker_block /etc/fuse.conf
        fi
        record_state FUSE_CONF_ACTION ""
        ;;
    esac
  fi
}

# --- Firewall handling (SW-9) --- #
# Rocky/RHEL and Leap 16 default-enforce firewalld; Ubuntu may run UFW. Open only
# what the enabled services need, remember exactly what WE added in the state file,
# reconcile on re-install (toggled-off ports are closed again), and let uninstall
# remove exactly the recorded set.

# Port/proto list for the currently-enabled features (Caddy/S3/MQ/monitoring/cluster).
firewall_collect_ports() {
  local ports="$SWFS_ADMIN_PORT/tcp $SWFS_MASTER_PORT/tcp $SWFS_FILER_PORT/tcp $SWFS_S3_PORT/tcp"
  [[ ${ENABLE_MQ,,} == "true" ]] && ports+=" $MQ_BROKER_PORT/tcp"
  [[ ${ENABLE_MONITORING,,} == "true" ]] && ports+=" $GRAFANA_PORT/tcp $LOKI_PORT/tcp $PROMETHEUS_EXT_PORT/tcp"
  [[ ${CLUSTER_MODE,,} == "cluster" ]] && ports+=" $CLUSTER_MASTER_GRPC_PORT/tcp $CLUSTER_VOLUME_PORT/tcp $CLUSTER_VOLUME_GRPC_PORT/tcp"
  echo "$ports"
}

# configure_firewall "<port/proto list>" "<smb: true|false>" "<nfs: true|false>"
configure_firewall() {
  local want_ports="$1" want_smb="$2" want_nfs="$3"
  local want_services=""
  # firewalld models SMB/NFSv3 helper ports (rpcbind/mountd) as named services.
  [[ "$want_smb" == "true" ]] && want_services+="samba "
  [[ "$want_nfs" == "true" ]] && want_services+="nfs rpc-bind mountd "
  if systemctl is-active firewalld >/dev/null 2>&1 && command -v firewall-cmd >/dev/null 2>&1; then
    echo "  firewalld is active — reconciling required ports/services..."
    local prior_ports prior_services keep_ports="" keep_services="" p s changed=0
    prior_ports=$(get_state FIREWALLD_ADDED_PORTS)
    prior_services=$(get_state FIREWALLD_ADDED_SERVICES)
    # Close ports/services we opened earlier that are no longer wanted (toggle-off).
    for p in $prior_ports; do
      if ! list_contains "$p" "$want_ports"; then
        firewall-cmd --permanent --remove-port="$p" >/dev/null 2>&1 && changed=1
      fi
    done
    for s in $prior_services; do
      if ! list_contains "$s" "$want_services"; then
        firewall-cmd --permanent --remove-service="$s" >/dev/null 2>&1 && changed=1
      fi
    done
    # Open what is wanted; only claim ownership of entries WE actually add.
    for p in $want_ports; do
      if firewall-cmd --permanent --query-port="$p" >/dev/null 2>&1; then
        list_contains "$p" "$prior_ports" && keep_ports+="$p "
      else
        firewall-cmd --permanent --add-port="$p" >/dev/null 2>&1 && keep_ports+="$p " && changed=1
      fi
    done
    for s in $want_services; do
      if firewall-cmd --permanent --query-service="$s" >/dev/null 2>&1; then
        list_contains "$s" "$prior_services" && keep_services+="$s "
      else
        firewall-cmd --permanent --add-service="$s" >/dev/null 2>&1 && keep_services+="$s " && changed=1
      fi
    done
    [[ $changed -eq 1 ]] && firewall-cmd --reload >/dev/null 2>&1
    record_state FIREWALLD_ADDED_PORTS "${keep_ports% }"
    record_state FIREWALLD_ADDED_SERVICES "${keep_services% }"
  elif command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
    echo "  UFW is active — reconciling required ports..."
    # UFW has no service objects for SMB/NFS — use the well-known ports. NOTE: NFSv3
    # mountd uses a dynamic port unless pinned; firewalld handles this via its
    # 'mountd' service, UFW cannot (documented in README).
    [[ "$want_smb" == "true" ]] && want_ports+=" 445/tcp 139/tcp"
    [[ "$want_nfs" == "true" ]] && want_ports+=" 2049/tcp 111/tcp 111/udp"
    local prior_ports keep_ports="" p
    prior_ports=$(get_state UFW_ADDED_PORTS)
    for p in $prior_ports; do
      if ! list_contains "$p" "$want_ports"; then
        ufw --force delete allow "$p" >/dev/null 2>&1
      fi
    done
    for p in $want_ports; do
      ufw allow "$p" comment 'seaweedfs-installer' >/dev/null 2>&1 && keep_ports+="$p "
    done
    record_state UFW_ADDED_PORTS "${keep_ports% }"
  else
    echo "  No active firewall manager (firewalld/UFW) detected — no firewall changes made."
  fi
}

# Uninstall: remove exactly what configure_firewall recorded.
# $1=firewalld ports  $2=firewalld services  $3=ufw ports
remove_firewall_rules() {
  local fwd_ports="$1" fwd_services="$2" ufw_ports="$3" p s changed=0
  if [[ -n "$fwd_ports$fwd_services" ]] && command -v firewall-cmd >/dev/null 2>&1; then
    echo "  Removing firewalld ports/services added by this installer..." | tee -a "$LOG_FILE"
    for p in $fwd_ports; do
      firewall-cmd --permanent --remove-port="$p" >/dev/null 2>&1 && changed=1
    done
    for s in $fwd_services; do
      firewall-cmd --permanent --remove-service="$s" >/dev/null 2>&1 && changed=1
    done
    [[ $changed -eq 1 ]] && firewall-cmd --reload >/dev/null 2>&1
  fi
  if [[ -n "$ufw_ports" ]] && command -v ufw >/dev/null 2>&1; then
    echo "  Removing UFW rules added by this installer..." | tee -a "$LOG_FILE"
    for p in $ufw_ports; do
      ufw --force delete allow "$p" >/dev/null 2>&1
    done
  fi
}

# --- SELinux handling (SW-10) --- #
# On enforcing hosts (Rocky/RHEL, Leap 16) smbd cannot read the FUSE-mounted
# /mnt/seaweed without the samba_share_fusefs boolean. Apply it (recording the prior
# value for uninstall) or warn loudly with the exact remediation.
configure_selinux() {
  command -v getenforce >/dev/null 2>&1 || return 0
  [[ "$(getenforce 2>/dev/null)" == "Enforcing" ]] || return 0
  if [[ ${ENABLE_SMB,,} == "true" ]]; then
    echo "  SELinux is enforcing — enabling Samba access to the FUSE share..."
    local prior=""
    prior=$(getsebool samba_share_fusefs 2>/dev/null | awk '{print $3}')
    if [[ -z "$prior" ]]; then
      echo "  WARNING: samba_share_fusefs boolean not found — the SMB share will likely be blocked by SELinux." | tee -a "$LOG_FILE"
      echo "  Remediation: install the samba SELinux policy, then: setsebool -P samba_share_fusefs on" | tee -a "$LOG_FILE"
    elif [[ "$prior" != "on" ]]; then
      if setsebool -P samba_share_fusefs on 2>/dev/null; then
        record_state SELINUX_SAMBA_FUSEFS_PRIOR "$prior"
      else
        echo "  WARNING: failed to set samba_share_fusefs — run manually: setsebool -P samba_share_fusefs on" | tee -a "$LOG_FILE"
      fi
    fi
  fi
  if [[ ${ENABLE_NFS,,} == "true" ]]; then
    if [[ "$(getsebool nfs_export_all_rw 2>/dev/null | awk '{print $3}')" == "off" ]]; then
      echo "  WARNING: SELinux boolean nfs_export_all_rw is off — NFS clients may be denied writes." | tee -a "$LOG_FILE"
      echo "  Remediation: setsebool -P nfs_export_all_rw on" | tee -a "$LOG_FILE"
    fi
  fi
}

install_swfs () {
  echo "# -- SeaweedFS Installer Started - $(date) -- #" | tee -a "$LOG_FILE"
  mkdir -p /opt/caddy/srv
  mkdir -p /opt/seaweedfs/mini
  record_state STATE_VERSION "1"
  record_state INSTALL_DATE "$(date)"
  record_state NODE_ROLE "control"
  record_state FILER_DIR_NAME "$DEFAULT_FILER_DIR_NAME"
  record_state MQ_CONFIGURED "${ENABLE_MQ,,}"
  reconcile_disabled_services
  debug_run run_docker || die "Docker/image preparation failed."
  if [[ $AIR_GAPPED_MODE -eq 0 ]]; then
    download_binaries || die "Artifact download failed."
  fi
  local caddyfile_before
  caddyfile_before=$(file_md5 /opt/caddy/Caddyfile)
  generate_caddyfile
  generate_compose_file
  record_state LOADED_IMAGES "$SWFS_IMAGE $CADDY_IMAGE"
  generate_index_html
  echo "  Starting SeaweedFS and Caddy containers..."
  docker compose -f /opt/seaweedfs/seaweedfs-compose.yaml up -d --remove-orphans \
    || die "docker compose up failed for /opt/seaweedfs/seaweedfs-compose.yaml."
  # Apply a regenerated Caddyfile to an already-running container (SW-8): compose
  # only recreates on compose-file changes, not bind-mounted config changes.
  restart_if_changed seaweed-caddy "$caddyfile_before" "$(file_md5 /opt/caddy/Caddyfile)"
  echo "  Waiting for SeaweedFS and Caddy to start..."
  local response_code=""
  local attempt=1
  local filer_ready=0
  while [[ $attempt -le 24 ]]; do
    echo "  Waiting for SeaweedFS Filer to start... (attempt $attempt/24)"
    response_code=$(docker exec -i seaweed-mini curl -sS -m 2 -o /dev/null -w '%{http_code}' http://localhost:8888 2>/dev/null)
    if [[ -n $response_code && $response_code -ge "200" && $response_code -lt "300" ]]; then
      filer_ready=1
      break
    fi
    ((attempt++))
    sleep 5
  done
  if [[ $filer_ready -ne 1 ]]; then
    die "Timeout waiting for SeaweedFS Filer to become ready (120s). Check 'docker logs seaweed-mini'."
  fi
  echo "  Creating default artifact directory on SeaweedFS Filer..."
  docker exec -i seaweed-mini curl -sf -X POST http://localhost:8888/$DEFAULT_FILER_DIR_NAME/ >/dev/null \
    || die "Failed to create default artifact directory '$DEFAULT_FILER_DIR_NAME' on the Filer."
  upload_binaries
  echo "  Configuring S3 credentials..."
  local shell_out=""
  shell_out=$(echo "s3.configure -access_key=$S3_ACCESS_KEY -secret_key=$S3_SECRET_KEY -user=$S3_USER -actions=Read,Write,List,Admin -apply=true" | docker exec -i seaweed-mini /usr/bin/weed shell 2>&1)
  echo "$shell_out" >> "$LOG_FILE"
  echo "$shell_out" | grep -qiE '(^|[[:space:]])(error|failed)' && die "S3 credential configuration failed (see $LOG_FILE)."
  echo "  Creating S3 buckets..."
  local all_buckets="$S3_BUCKET"
  if [[ ${ENABLE_MONITORING,,} == "true" ]] && ! list_contains "$LOKI_BUCKET" "$all_buckets"; then
    all_buckets="$all_buckets $LOKI_BUCKET"
  fi
  for extra in $EXTRA_BUCKETS; do
    list_contains "$extra" "$all_buckets" || all_buckets="$all_buckets $extra"
  done
  local existing_buckets=""
  existing_buckets=$(echo "s3.bucket.list" | docker exec -i seaweed-mini /usr/bin/weed shell 2>/dev/null | awk '{print $1}')
  for bucket in $all_buckets; do
    if echo "$existing_buckets" | grep -Fxq "$bucket"; then
      echo "  Bucket already exists, skipping: $bucket"
      continue
    fi
    echo "  Creating bucket: $bucket"
    shell_out=$(echo "s3.bucket.create -name $bucket -owner=$S3_USER" | docker exec -i seaweed-mini /usr/bin/weed shell 2>&1)
    echo "$shell_out" >> "$LOG_FILE"
    echo "$shell_out" | grep -qiE '(^|[[:space:]])(error|failed)' && die "Failed to create S3 bucket '$bucket' (see $LOG_FILE)."
  done
  if [[ ${ENABLE_MONITORING,,} == "true" ]]; then
    echo "  Setting up monitoring stack (Loki, Grafana, Prometheus)..."
    debug_run setup_monitoring || die "Monitoring stack setup failed."
  fi
  if [[ ${ENABLE_SMB,,} == "true" ]]; then
    run_smb
  fi
  if [[ ${ENABLE_NFS,,} == "true" ]]; then
    run_nfs
  fi
  # SELinux boolean check must come AFTER the samba packages (and their SELinux
  # policy) are installed by run_smb.
  configure_selinux
  configure_firewall "$(firewall_collect_ports)" "${ENABLE_SMB,,}" "${ENABLE_NFS,,}"
  generate_outputs
}

run_docker() {
  echo "  Verifying Docker Config..."
  if [[ $AIR_GAPPED_MODE -eq 0 ]]; then
    download_image_pull_push
    if [[ $PUSH_MODE -eq 1 ]]; then
      cat >"$base_dir/utilities/images.txt" <<EOF
$SWFS_IMAGE
$CADDY_IMAGE
EOF
      if [[ ${ENABLE_MONITORING,,} == "true" ]]; then
        cat >> "$base_dir/utilities/images.txt" <<EOF
$LOKI_IMAGE
$GRAFANA_IMAGE
$PROMETHEUS_EXT_IMAGE
EOF
      fi
      "$base_dir/utilities/image_pull_push.sh" -f "$base_dir/utilities/images.txt" push "$REGISTRY_INFO" "$REG_USER" "$REG_PASS" \
        || die "image_pull_push.sh push to $REGISTRY_INFO failed."
    else
      # Still grab registry cert if needed
      if [[ $REGISTRY_MODE -eq 1 ]]; then
        "$base_dir/utilities/image_pull_push.sh" reg-cert "$REGISTRY_INFO" \
          || die "image_pull_push.sh reg-cert for $REGISTRY_INFO failed."
      fi
      "$base_dir/utilities/image_pull_push.sh" docker \
        || die "image_pull_push.sh docker (Docker runtime setup) failed."
    fi
  else
    # AIR_GAPPED_MODE is set
    shopt -s nullglob
    local image_archives=("$base_dir"/utilities/container_images_*.tar.gz)
    shopt -u nullglob
    if [[ ${#image_archives[@]} -eq 0 ]]; then
      die "Air-gapped mode: no container_images_*.tar.gz archives found in $base_dir/utilities/ — the save bundle is incomplete."
    fi
    local file
    for file in "${image_archives[@]}"; do
      if [[ $PUSH_MODE -eq 1 ]]; then
        "$base_dir/utilities/image_pull_push.sh" -f "$file" push "$REGISTRY_INFO" "$REG_USER" "$REG_PASS" \
          || die "image_pull_push.sh push of $(basename "$file") failed."
      else
        "$base_dir/utilities/image_pull_push.sh" -f "$file" keep \
          || die "image_pull_push.sh load of $(basename "$file") failed."
      fi
    done
    # Still grab registry cert if needed
    if [[ $REGISTRY_MODE -eq 1 ]]; then
      "$base_dir/utilities/image_pull_push.sh" reg-cert "$REGISTRY_INFO" \
        || die "image_pull_push.sh reg-cert for $REGISTRY_INFO failed."
    fi
  fi
  if [[ $REGISTRY_MODE -eq 1 ]]; then
    echo "  Logging into local registry $REG_FQDN:$REG_PORT ..."
    printf '%s' "$REG_PASS" | docker login "$REG_FQDN:$REG_PORT" -u "$REG_USER" --password-stdin \
      || die "docker login to $REG_FQDN:$REG_PORT failed."
    record_state REGISTRY_LOGIN "$REG_FQDN:$REG_PORT"
  fi
}

run_smb () {
  # Debian/Ubuntu name the unit 'smbd'; RHEL/Rocky/SLES use 'smb'
  if [[ $ID != "ubuntu" && $ID != "debian" ]]; then
    SMB_SERVICE="smb"
  fi
  if [[ $AIR_GAPPED_MODE -eq 0 ]]; then
    download_install_packages
    cd "$base_dir/utilities" || die "Cannot enter $base_dir/utilities."
    debug_run ./install_packages.sh online samba || die "Samba package installation failed."
    cd "$base_dir"
  else
    cd "$base_dir/utilities" || die "Cannot enter $base_dir/utilities."
    debug_run ./install_packages.sh offline samba || die "Samba package installation (offline) failed."
    cd "$base_dir"
  fi
  echo "  Configuring Samba..."
  # Create the SMB user idempotently. If a group of the same name already exists
  # (e.g. Ubuntu ships a pre-existing 'admin' group and SWFS_USER defaults to 'admin'),
  # attach to it with -g; otherwise useradd would abort and the SMB user is never created.
  # Record whether WE created the account: uninstall must never delete a pre-existing user.
  if ! id "$SWFS_USER" &>/dev/null; then
    swfs_user_group_flag=""
    getent group "$SWFS_USER" >/dev/null 2>&1 && swfs_user_group_flag="-g $SWFS_USER"
    useradd -M -s /sbin/nologin $swfs_user_group_flag "$SWFS_USER" || die "Failed to create SMB user '$SWFS_USER'."
    record_state SWFS_USER_CREATED "true"
  else
    [[ "$(get_state SWFS_USER_CREATED)" == "true" ]] || record_state SWFS_USER_CREATED "false"
  fi
  record_state SWFS_USER_NAME "$SWFS_USER"
  (echo "$SWFS_PASSWORD"; echo "$SWFS_PASSWORD") | smbpasswd -a -s "$SWFS_USER" \
    || die "smbpasswd failed for user '$SWFS_USER'."
  # One-time backup of the pre-install smb.conf (kept for operator reference; the
  # marker block below — not this backup — is what uninstall removes).
  [[ -f /etc/samba/smb.conf.bak ]] || cp -p /etc/samba/smb.conf /etc/samba/smb.conf.bak
  # Reconcile: remove any previous seaweedfs-installer block (marked or legacy
  # pre-marker), then append the current one. Re-runs converge instead of duplicating.
  remove_marker_block /etc/samba/smb.conf
  remove_legacy_smb_block "$DEFAULT_FILER_DIR_NAME"
  cat >> /etc/samba/smb.conf <<EOF
${MARKER_BEGIN}
[$DEFAULT_FILER_DIR_NAME]
   comment = SeaweedFS FUSE Mount
   path = /mnt/seaweed
   browseable = yes
   read only = no
   guest ok = no
   valid users = $SWFS_USER
   create mask = 0664
   directory mask = 0775

   vfs objects = fruit streams_xattr
   fruit:metadata = stream
   fruit:model = MacSamba

   force user = root
   force group = root
${MARKER_END}
EOF
  echo "  Restarting Samba..."
  systemctl restart "$SMB_SERVICE" || die "Failed to restart Samba service '$SMB_SERVICE'."
  record_state SMB_CONFIGURED "true"
  record_state SMB_SERVICE_NAME "$SMB_SERVICE"
  record_state SMB_SHARE_NAME "$DEFAULT_FILER_DIR_NAME"
}

run_nfs () {
  if [[ $ID == "ubuntu" || $ID == "debian" ]]; then
    NFS_SERVICE="nfs-kernel-server"
  fi
  if [[ $AIR_GAPPED_MODE -eq 0 ]]; then
    download_install_packages
    cd "$base_dir/utilities" || die "Cannot enter $base_dir/utilities."
    debug_run ./install_packages.sh online "$NFS_PACKAGE" || die "NFS server package ($NFS_PACKAGE) installation failed."
    cd "$base_dir"
  else
    cd "$base_dir/utilities" || die "Cannot enter $base_dir/utilities."
    debug_run ./install_packages.sh offline "$NFS_PACKAGE" || die "NFS server package ($NFS_PACKAGE) installation (offline) failed."
    cd "$base_dir"
  fi
  echo "  Configuring NFS export..."
  # Reconcile: drop any previously-appended seaweedfs-installer export line first so
  # re-installs never duplicate the export (the trailing marker tags our lines).
  [[ -f /etc/exports ]] && sed -i '/ # seaweedfs-installer$/d' /etc/exports
  # fsid= is REQUIRED here: /mnt/seaweed is a FUSE (weed mount) filesystem, which
  # has no stable device UUID for knfsd to derive filehandles from. Without an
  # explicit fsid, exportfs warns/refuses and clients hit ESTALE after a weed
  # mount or server restart. fsid=1 (never 0 — 0 is the NFSv4 pseudo-root).
  cat >> /etc/exports <<EOF
/mnt/seaweed *(rw,sync,no_subtree_check,no_root_squash,insecure,fsid=1) # seaweedfs-installer
EOF
  echo "  Exporting NFS filesystem..."
  exportfs -ra || die "exportfs -ra failed."
  echo "  Restarting NFS service..."
  systemctl enable "$NFS_SERVICE"
  systemctl restart "$NFS_SERVICE" || die "Failed to restart NFS service '$NFS_SERVICE'."
  configure_nfs_meta_refresh
  record_state NFS_CONFIGURED "true"
  record_state NFS_SERVICE_NAME "$NFS_SERVICE"
}

# NFSv3 re-export of the weed-mount FUSE filesystem is only *eventually* consistent
# for writes made OUTSIDE the NFS path (filer HTTP API, S3 gateway, the Caddy web
# uploader, another node). Root cause, confirmed by testing: the filer does not bump
# a directory's mtime when a child is added/removed, so NFS clients never get the
# "directory changed" signal that would invalidate their cached listing — and the
# staleness actually lives in THIS server's kernel dentry/inode cache as consumed by
# knfsd. No NFS client mount option (noac/actimeo=0/nordirplus/lookupcache), no weed
# -cacheMetaTtlSec value, and no weed version bump fixes it; only dropping this
# server's dentry/inode cache does. This timer does exactly that on a fixed interval,
# bounding out-of-band-write visibility to ~NFS_META_REFRESH_SEC. Writes made THROUGH
# NFS are already coherent between clients (they share one knfsd). Set
# NFS_META_REFRESH_SEC=0 to disable (e.g. if every writer uses the NFS path, or each
# client runs its own weed mount instead — see README "NFS consistency model").
configure_nfs_meta_refresh () {
  local svc="/etc/systemd/system/seaweedfs-nfs-meta-refresh.service"
  local tmr="/etc/systemd/system/seaweedfs-nfs-meta-refresh.timer"
  if [[ ! "$NFS_META_REFRESH_SEC" =~ ^[0-9]+$ || "$NFS_META_REFRESH_SEC" -eq 0 ]]; then
    echo "  NFS metadata refresh disabled (NFS_META_REFRESH_SEC=$NFS_META_REFRESH_SEC)."
    systemctl disable --now seaweedfs-nfs-meta-refresh.timer >/dev/null 2>&1
    rm -f "$svc" "$tmr"
    systemctl daemon-reload
    return
  fi
  echo "  Installing NFS metadata refresh timer (every ${NFS_META_REFRESH_SEC}s)..."
  cat > "$svc" <<EOF
[Unit]
Description=SeaweedFS NFS re-export metadata cache refresh
Documentation=https://github.com/Chubtoad5/seaweedfs-installer

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'sync; echo 2 > /proc/sys/vm/drop_caches'
EOF
  cat > "$tmr" <<EOF
[Unit]
Description=Periodic SeaweedFS NFS metadata cache refresh (every ${NFS_META_REFRESH_SEC}s)

[Timer]
OnBootSec=${NFS_META_REFRESH_SEC}s
OnUnitActiveSec=${NFS_META_REFRESH_SEC}s
AccuracySec=1s
Unit=seaweedfs-nfs-meta-refresh.service

[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload
  systemctl enable seaweedfs-nfs-meta-refresh.timer >/dev/null 2>&1
  # restart (not 'enable --now') so a CHANGED interval takes effect on a running timer (SW-16)
  systemctl restart seaweedfs-nfs-meta-refresh.timer || die "Failed to start the NFS metadata refresh timer."
}

generate_caddyfile () {
  if [[ $PUSH_MODE -eq 1 || $REGISTRY_MODE -eq 1 ]]; then
    local caddy_image_local="${REG_FQDN}:${REG_PORT}/library/$CADDY_IMAGE"
  else
    local caddy_image_local="$CADDY_IMAGE"
  fi
  CADDY_HASHED_PASSWORD=$(docker run --rm ${caddy_image_local} caddy hash-password --plaintext "${SWFS_PASSWORD}")
  if [[ -z "$CADDY_HASHED_PASSWORD" ]]; then
    die "Failed to hash SWFS_PASSWORD with the Caddy image ($caddy_image_local). Is the image available?"
  fi
  echo "  Creating Caddyfile..." | tee -a "$LOG_FILE"
  cat > /opt/caddy/Caddyfile <<EOF
{
        debug
        default_sni $MGMT_IP
}
$SWFS_ADMIN_FQDN:$SWFS_ADMIN_PORT, https://$MGMT_IP:$SWFS_ADMIN_PORT {
        tls internal
        handle {
                root * /srv
                file_server
        }
        handle /static* {
                reverse_proxy seaweed-mini:23646
        }
        handle /login* {
                reverse_proxy seaweed-mini:23646
        }
        handle /logout* {
                reverse_proxy seaweed-mini:23646
        }
        handle /admin* {
                reverse_proxy seaweed-mini:23646
        }
        handle /cluster* {
                reverse_proxy seaweed-mini:23646
        }
        handle /storage* {
                reverse_proxy seaweed-mini:23646
        }
        handle /files* {
                reverse_proxy seaweed-mini:23646
        }
        handle /object-store* {
                reverse_proxy seaweed-mini:23646
        }
        handle /mq* {
                reverse_proxy seaweed-mini:23646
        }
        handle /metrics* {
                reverse_proxy seaweed-mini:23646
        }
        handle /logs* {
                reverse_proxy seaweed-mini:23646
        }
        handle /maintenance* {
                reverse_proxy seaweed-mini:23646
        }
        handle /api* {
                reverse_proxy seaweed-mini:23646
        }
        handle /$DEFAULT_FILER_DIR_NAME* {
                @isDomain host $SWFS_ADMIN_FQDN
                redir @isDomain https://$SWFS_FILER_FQDN:$SWFS_FILER_PORT/$DEFAULT_FILER_DIR_NAME permanent
                redir https://{host}:$SWFS_FILER_PORT/$DEFAULT_FILER_DIR_NAME permanent
        }
}
$SWFS_FILER_FQDN:$SWFS_FILER_PORT, https://$MGMT_IP:$SWFS_FILER_PORT {
        tls internal
        handle /seaweedfsstatic/* {
                reverse_proxy seaweed-mini:8888
        }
        handle /$DEFAULT_FILER_DIR_NAME* {
                basic_auth {
                        $SWFS_USER $CADDY_HASHED_PASSWORD
                }
                reverse_proxy seaweed-mini:8888
        }
        handle {
                @isDomain host $SWFS_FILER_FQDN
                redir @isDomain https://$SWFS_ADMIN_FQDN permanent
                redir https://{host} permanent
        }
}
$SWFS_MASTER_FQDN:$SWFS_MASTER_PORT, https://$MGMT_IP:$SWFS_MASTER_PORT {
        tls internal
        basic_auth {
                $SWFS_USER $CADDY_HASHED_PASSWORD
        }
        reverse_proxy seaweed-mini:9333
}
$SWFS_S3_FQDN:$SWFS_S3_PORT, https://$MGMT_IP:$SWFS_S3_PORT {
        tls internal
        reverse_proxy seaweed-mini:8333
}
EOF
  if [[ ${ENABLE_MONITORING,,} == "true" ]]; then
    cat >> /opt/caddy/Caddyfile <<EOF
$GRAFANA_FQDN:$GRAFANA_PORT, https://$MGMT_IP:$GRAFANA_PORT {
        tls internal
        reverse_proxy grafana:3000
}
EOF
  fi
}

generate_compose_file () {
  if [[ $PUSH_MODE -eq 1 || $REGISTRY_MODE -eq 1 ]]; then
    SWFS_IMAGE="${REG_FQDN}:${REG_PORT}/$SWFS_IMAGE"
    CADDY_IMAGE="${REG_FQDN}:${REG_PORT}/library/$CADDY_IMAGE"
  else
    SWFS_IMAGE="$SWFS_IMAGE"
    CADDY_IMAGE="$CADDY_IMAGE"
  fi
  # Pre-compute optional Caddy port line for monitoring
  local CADDY_MONITORING_PORT=""
  if [[ ${ENABLE_MONITORING,,} == "true" ]]; then
    CADDY_MONITORING_PORT="      - \"$GRAFANA_PORT:$GRAFANA_PORT\""
  fi
  # Pre-compute optional 'weed mini' tuning flags (folded into the command: > block)
  local MINI_TUNING=""
  [[ -n "$VOLUME_INDEX" ]] && MINI_TUNING+="      -volume.index=$VOLUME_INDEX"$'\n'
  [[ -n "$VOLUME_SIZE_LIMIT_MB" ]] && MINI_TUNING+="      -master.volumeSizeLimitMB=$VOLUME_SIZE_LIMIT_MB"$'\n'
  # Pre-compute optional cluster-ready flags + host-published cluster ports (CLUSTER_MODE=cluster).
  # Empty in single-node mode => the compose below is byte-identical to the non-cluster default.
  local MINI_CLUSTER=""
  local MINI_CLUSTER_PORTS=""
  if [[ ${CLUSTER_MODE,,} == "cluster" ]]; then
    MINI_CLUSTER+="      -ip=$MGMT_IP"$'\n'
    [[ -n "$CLUSTER_REPLICATION" ]] && MINI_CLUSTER+="      -master.defaultReplication=$CLUSTER_REPLICATION"$'\n'
    MINI_CLUSTER+="      -dataCenter=$CLUSTER_DC"$'\n'
    MINI_CLUSTER+="      -rack=$CLUSTER_RACK"$'\n'
    MINI_CLUSTER+="      -master.port.grpc=$CLUSTER_MASTER_GRPC_PORT"$'\n'
    MINI_CLUSTER+="      -volume.port=$CLUSTER_VOLUME_PORT"$'\n'
    MINI_CLUSTER+="      -volume.port.grpc=$CLUSTER_VOLUME_GRPC_PORT"$'\n'
    MINI_CLUSTER_PORTS+="    ports:"$'\n'
    MINI_CLUSTER_PORTS+="      - \"$CLUSTER_MASTER_GRPC_PORT:$CLUSTER_MASTER_GRPC_PORT\""$'\n'
    MINI_CLUSTER_PORTS+="      - \"$CLUSTER_VOLUME_PORT:$CLUSTER_VOLUME_PORT\""$'\n'
    MINI_CLUSTER_PORTS+="      - \"$CLUSTER_VOLUME_GRPC_PORT:$CLUSTER_VOLUME_GRPC_PORT\""$'\n'
  fi
  echo "  Creating seaweedfs-compose.yaml..." | tee -a "$LOG_FILE"
  cat > /opt/seaweedfs/seaweedfs-compose.yaml <<EOF
networks:
  seaweed_net:
    name: seaweed_net
services:
  seaweed-mini:
    image: $SWFS_IMAGE
    container_name: seaweed-mini
    command: >
      mini
      -admin.user "$SWFS_USER"
      -admin.password "$SWFS_PASSWORD"
      -dir=/data
      -webdav=false
${MINI_TUNING}${MINI_CLUSTER}    volumes:
      - /opt/seaweedfs/mini:/data
${MINI_CLUSTER_PORTS}    networks:
      - seaweed_net
    restart: unless-stopped
  caddy:
    image: $CADDY_IMAGE
    container_name: seaweed-caddy
    ports:
      # - "80:80" # Reserved for future automatic_https
      - "$SWFS_ADMIN_PORT:$SWFS_ADMIN_PORT"
      - "$SWFS_MASTER_PORT:$SWFS_MASTER_PORT"
      - "$SWFS_FILER_PORT:$SWFS_FILER_PORT"
      - "$SWFS_S3_PORT:$SWFS_S3_PORT"
$CADDY_MONITORING_PORT
    volumes:
      - /opt/caddy/Caddyfile:/etc/caddy/Caddyfile
      - /opt/caddy/srv/index.html:/srv/index.html
    networks:
      - seaweed_net
    restart: unless-stopped
    depends_on:
      - seaweed-mini
EOF
  if [[ ${ENABLE_MQ,,} == "true" ]]; then
    cat >> /opt/seaweedfs/seaweedfs-compose.yaml <<EOF
  seaweed-mq:
    image: $SWFS_IMAGE
    container_name: seaweed-mq
    command: >
      mq.broker
      -port=$MQ_BROKER_PORT
      -master=seaweed-mini:9333
    ports:
      - "$MQ_BROKER_PORT:$MQ_BROKER_PORT"
    networks:
      - seaweed_net
    restart: unless-stopped
    depends_on:
      - seaweed-mini
EOF
  fi
  if [[ ${ENABLE_SMB,,} == "true" || ${ENABLE_NFS,,} == "true" ]]; then
    mkdir -p /mnt/seaweed
    configure_fuse_conf
    cat >> /opt/seaweedfs/seaweedfs-compose.yaml <<EOF
  seaweed-mount:
    image: $SWFS_IMAGE
    container_name: seaweed-mount
    privileged: true
    command:
      mount
      -filer=seaweed-mini:8888
      -filer.path=/$DEFAULT_FILER_DIR_NAME
    volumes:
      - "/mnt/seaweed:/data:z,shared"
      - "/etc/fuse.conf:/etc/fuse.conf:ro"
    restart: unless-stopped
    networks:
      - seaweed_net
EOF
fi
}


